# The lab's settings. Copy this file to .env next to it (lab/.env, which git ignores) and fill it in; the app reads
# it when started from lab/ (`make lab` does). Instances created afterwards get these.

# The admin of every new instance: your email, and the password to sign in with.
LAB_ADMIN_EMAIL=yourname@metabase.com
LAB_ADMIN_PASSWORD=metabot1

# A Metabase license token. It turns on the premium features: the writable connection, transforms, the library and
# remote sync. Without one that has writable-connection, the databases get no writable connection (see README.md).
MB_PREMIUM_EMBEDDING_TOKEN=
